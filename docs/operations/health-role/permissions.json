{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2HealthMetadataInDeploymentRegion",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}
