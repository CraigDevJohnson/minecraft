{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListNamedRecoveryVersions",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::example-prefix-backups",
      "Condition": {"StringLike": {"s3:prefix": ["instances/survival/*"]}}
    },
    {
      "Sid": "LocateTheRecoveryBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::example-prefix-backups"
    },
    {
      "Sid": "ReadTheRecoveryBucketLifecycle",
      "Effect": "Allow",
      "Action": "s3:GetLifecycleConfiguration",
      "Resource": "arn:aws:s3:::example-prefix-backups"
    },
    {
      "Sid": "ReadExactRecoveryObjectsAndTags",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectTagging", "s3:GetObjectVersionTagging"],
      "Resource": ["arn:aws:s3:::example-prefix-backups/instances/survival/completed/*",
                   "arn:aws:s3:::example-prefix-backups/instances/survival/objects/*",
                   "arn:aws:s3:::example-prefix-backups/instances/survival/receipts/*"]
    },
    {
      "Sid": "SetOnlyTheRequiredRetentionTag",
      "Effect": "Allow",
      "Action": ["s3:PutObjectTagging", "s3:PutObjectVersionTagging"],
      "Resource": ["arn:aws:s3:::example-prefix-backups/instances/survival/completed/*",
                   "arn:aws:s3:::example-prefix-backups/instances/survival/objects/*",
                   "arn:aws:s3:::example-prefix-backups/instances/survival/receipts/*"],
      "Condition": {
        "StringEquals": {"s3:RequestObjectTag/minecraft-retention": ["keep", "retired"]},
        "ForAllValues:StringEquals": {"s3:RequestObjectTagKeys": ["minecraft-retention"]},
        "Null": {"s3:RequestObjectTagKeys": "false", "s3:RequestObjectTag/minecraft-retention": "false"}
      }
    },
    {
      "Sid": "PublishImmutableReceipt",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::example-prefix-backups/instances/survival/receipts/????????????????????????????????????????????????????????????????.json",
      "Condition": {"StringEquals": {"s3:if-none-match": "*"}}
    },
    {
      "Sid": "CreateTheFirstSelectionConditionally",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::example-prefix-backups/instances/survival/receipts/current.json",
      "Condition": {"StringEquals": {"s3:if-none-match": "*"}}
    },
    {
      "Sid": "AdvanceTheObservedSelectionConditionally",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::example-prefix-backups/instances/survival/receipts/current.json",
      "Condition": {"Null": {"s3:if-match": "false"}}
    },
    {
      "Sid": "NeverManuallyDeleteRecoveryVersionsOrSelection",
      "Effect": "Deny",
      "Action": "s3:DeleteObjectVersion",
      "Resource": "arn:aws:s3:::example-prefix-backups/instances/survival/*"
    },
    {
      "Sid": "NeverDeleteAuthoritativeSelection",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::example-prefix-backups/instances/survival/receipts/current.json"
    }
  ]
}
