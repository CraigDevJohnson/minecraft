{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "AdministratorSsoOnly",
    "Effect": "Allow",
    "Principal": {"AWS": "arn:aws:iam::123456789012:root"},
    "Action": ["sts:AssumeRole", "sts:SetSourceIdentity"],
    "Condition": {"ArnLike": {"aws:PrincipalArn": "arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/us-west-2/AWSReservedSSO_ExampleAdmin_*"}}
  }]
}
