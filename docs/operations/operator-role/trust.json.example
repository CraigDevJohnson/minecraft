{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "AdministratorSsoOnly",
    "Effect": "Allow",
    "Principal": {"AWS": "arn:aws:iam::123456789012:root"},
    "Action": ["sts:AssumeRole", "sts:SetSourceIdentity"],
    "Condition": {"ArnLike": {"aws:PrincipalArn": "arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/us-west-2/AWSReservedSSO_ExampleAdmin_*"}}
  }, {
    "Sid": "DeployWorkflowOnly",
    "Effect": "Allow",
    "Principal": {"Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"},
    "Action": "sts:AssumeRoleWithWebIdentity",
    "Condition": {"StringEquals": {
      "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
      "token.actions.githubusercontent.com:sub": "repo:CraigDevJohnson@42454849/minecraft@1359070973:environment:deploy"
    }}
  }]
}
