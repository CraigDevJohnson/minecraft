{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "Ec2InDeploymentRegion", "Effect": "Allow", "Action": "ec2:*", "Resource": "*",
     "Condition": {"StringEquals": {"aws:RequestedRegion": "us-west-2"}}},
    {"Sid": "NeverWeakenEc2SecuritySettingsOrShare", "Effect": "Deny",
     "Action": ["ec2:DisableEbsEncryptionByDefault","ec2:ModifyEbsDefaultKmsKeyId","ec2:ResetEbsDefaultKmsKeyId","ec2:DisableSnapshotBlockPublicAccess","ec2:DisableImageBlockPublicAccess","ec2:EnableSerialConsoleAccess","ec2:ModifySnapshotAttribute","ec2:ModifyImageAttribute"],
     "Resource": "*"},
    {"Sid": "HostRolePermissionsOnlyWithinBoundary", "Effect": "Allow",
     "Action": ["iam:CreateRole","iam:PutRolePolicy","iam:DeleteRolePolicy","iam:AttachRolePolicy","iam:DetachRolePolicy","iam:PutRolePermissionsBoundary"],
     "Resource": "arn:aws:iam::123456789012:role/example-prefix-*",
     "Condition": {"StringEquals": {"iam:PermissionsBoundary": "arn:aws:iam::123456789012:policy/example-host-boundary"}}},
    {"Sid": "HostRolesAndProfiles", "Effect": "Allow",
     "Action": ["iam:DeleteRole","iam:GetRole","iam:UpdateRole","iam:UpdateAssumeRolePolicy","iam:TagRole","iam:UntagRole","iam:ListRoleTags","iam:ListRolePolicies","iam:ListAttachedRolePolicies","iam:GetRolePolicy","iam:ListInstanceProfilesForRole","iam:CreateInstanceProfile","iam:DeleteInstanceProfile","iam:GetInstanceProfile","iam:AddRoleToInstanceProfile","iam:RemoveRoleFromInstanceProfile","iam:TagInstanceProfile","iam:UntagInstanceProfile","iam:ListInstanceProfileTags"],
     "Resource": ["arn:aws:iam::123456789012:role/example-prefix-*","arn:aws:iam::123456789012:instance-profile/example-prefix-*"]},
    {"Sid": "PassHostRoleToEc2", "Effect": "Allow", "Action": "iam:PassRole",
     "Resource": "arn:aws:iam::123456789012:role/example-prefix-*",
     "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}},
    {"Sid": "NeverRemoveARoleBoundary", "Effect": "Deny", "Action": "iam:DeleteRolePermissionsBoundary", "Resource": "*"},
    {"Sid": "NeverChangeTheHostBoundary", "Effect": "Deny",
     "Action": ["iam:CreatePolicyVersion","iam:DeletePolicy","iam:DeletePolicyVersion","iam:SetDefaultPolicyVersion"],
     "Resource": "arn:aws:iam::123456789012:policy/example-host-boundary"},
    {"Sid": "ProjectBuckets", "Effect": "Allow", "Action": "s3:*",
     "Resource": ["arn:aws:s3:::example-prefix-*","arn:aws:s3:::example-prefix-*/*"]},
    {"Sid": "ProjectBudget", "Effect": "Allow",
     "Action": ["budgets:ViewBudget","budgets:ModifyBudget","budgets:ListTagsForResource","budgets:TagResource","budgets:UntagResource"],
     "Resource": "arn:aws:budgets::123456789012:budget/example-prefix-*"},
    {"Sid": "CommandsAndSessionsOnProjectHosts", "Effect": "Allow", "Action": ["ssm:SendCommand","ssm:StartSession"],
     "Resource": "arn:aws:ec2:us-west-2:123456789012:instance/*",
     "Condition": {"StringEquals": {"ssm:resourceTag/Project": "minecraft"}}},
    {"Sid": "ShellCommandDocumentOnly", "Effect": "Allow", "Action": "ssm:SendCommand",
     "Resource": "arn:aws:ssm:us-west-2::document/AWS-RunShellScript"},
    {"Sid": "DefaultShellSessionDocumentOnly", "Effect": "Allow", "Action": "ssm:StartSession",
     "Resource": "arn:aws:ssm:us-west-2:123456789012:document/SSM-SessionManagerRunShell"},
    {"Sid": "OwnSessionsOnly", "Effect": "Allow", "Action": ["ssm:TerminateSession","ssm:ResumeSession"],
     "Resource": "arn:aws:ssm:us-west-2:123456789012:session/*",
     "Condition": {"StringLike": {"ssm:resourceTag/aws:ssmmessages:session-id": ["${aws:userid}*"]}}},
    {"Sid": "SessionDataChannels", "Effect": "Allow", "Action": "ssmmessages:OpenDataChannel", "Resource": "*",
     "Condition": {"StringEquals": {"aws:RequestedRegion": "us-west-2"}}},
    {"Sid": "TrackCommandsAndSessions", "Effect": "Allow",
     "Action": ["ssm:CancelCommand","ssm:GetCommandInvocation","ssm:ListCommands","ssm:ListCommandInvocations","ssm:DescribeInstanceInformation","ssm:DescribeSessions","ssm:GetConnectionStatus"],
     "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": "us-west-2"}}},
    {"Sid": "ReadPublicAmiParameters", "Effect": "Allow", "Action": ["ssm:GetParameter","ssm:GetParameters"],
     "Resource": "arn:aws:ssm:us-west-2::parameter/aws/service/*"},
    {"Sid": "ReadVolumeAttachmentHistory", "Effect": "Allow", "Action": "cloudtrail:LookupEvents", "Resource": "*",
     "Condition": {"StringEquals": {"aws:RequestedRegion": "us-west-2"}}}
  ]
}
