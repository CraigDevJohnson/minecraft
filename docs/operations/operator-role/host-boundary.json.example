{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "SsmAgentRegistrationAndChannels", "Effect": "Allow",
     "Action": ["ssm:UpdateInstanceInformation","ssmmessages:CreateControlChannel","ssmmessages:CreateDataChannel","ssmmessages:OpenControlChannel","ssmmessages:OpenDataChannel"],
     "Resource": "*"},
    {"Sid": "LocateAndListProjectBuckets", "Effect": "Allow",
     "Action": ["s3:GetBucketLocation","s3:ListBucket"],
     "Resource": "arn:aws:s3:::example-prefix-*",
     "Condition": {"StringEquals": {"s3:ResourceAccount": "123456789012"}}},
    {"Sid": "ManageCurrentProjectBackupObjects", "Effect": "Allow",
     "Action": ["s3:GetObject","s3:PutObject","s3:DeleteObject","s3:AbortMultipartUpload","s3:ListMultipartUploadParts"],
     "Resource": "arn:aws:s3:::example-prefix-*/*",
     "Condition": {"StringEquals": {"s3:ResourceAccount": "123456789012"}}},
    {"Sid": "ReadHistoricalInstanceRecoveryObjects", "Effect": "Allow",
     "Action": ["s3:GetObjectVersion"],
     "Resource": ["arn:aws:s3:::example-prefix-*/instances/*/completed/*",
                  "arn:aws:s3:::example-prefix-*/instances/*/objects/*",
                  "arn:aws:s3:::example-prefix-*/instances/*/receipts/*"],
     "Condition": {"StringEquals": {"s3:ResourceAccount": "123456789012"}}}
  ]
}
