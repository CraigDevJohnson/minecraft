# Copy to ignored operator-config/<environment>/deployment.tfvars and replace all
# examples with reviewed private inputs during issue #7. Never commit real values.
account_id                = "111122223333"
# The operator role a workstation assumes. Leave it out of the copy the Deploy
# workflow reads: that job already runs as the operator role (ADR 0006).
operator_role_arn         = "arn:aws:iam::111122223333:role/minecraft-operator"
environment               = "family"
resource_prefix           = "minecraft-family"
region                    = "us-west-2"
availability_zone         = "us-west-2a"
ami_id                    = "ami-0123456789abcdef0"
ami_owner_account_id      = "111122223333"
backup_bucket_name        = "replace-with-reviewed-unique-private-backup-name"
data_filesystem_uuid      = "12345678-1234-4234-8234-123456789abc"
instance_ids              = ["survival"]
monthly_budget_usd        = 25
budget_notification_email = "operator@example.invalid"

# Optional: drain and stop an idle host. See docs/operations/idle-stop.md before
# enabling it. The Deploy workflow builds the package and names it through
# package_dir, so its copy of this file has no package_path; a workstation plan
# builds it with `task lambda:package` and names it here.
# idle_stop = {
#   package_path = "/absolute/path/to/minecraft/.build/idle-stop.zip"
#   idle_minutes = 30
#   cloudflare_token_secret_arn = "arn:aws:secretsmanager:us-west-2:111122223333:secret:cloudflare-token-abcdef"
# }

# Optional: the backend for The Lobby's Minecraft Launcher, one function per Lobby
# environment in sites (each may be called only by that site's role, and by the
# server control role in control_role_arn). See docs/operations/launcher.md and
# docs/operations/cloud-controls.md before enabling it. The package follows the
# same rule as idle_stop's.
# launcher = {
#   package_path = "/absolute/path/to/minecraft/.build/launcher.zip"
#   sites = {
#     dev  = "arn:aws:iam::111122223333:role/site-dev-server"
#     prod = "arn:aws:iam::111122223333:role/site-prod-server"
#   }
#   permissions_boundary_arn = "arn:aws:iam::111122223333:policy/minecraft-launcher-boundary"
#   control_role_arn         = "arn:aws:iam::111122223333:role/minecraft-server-control"
# }

# Retained data disk size in GiB. Grow only: never decrease it for an existing disk
# (docs/operations/data-disk-capacity.md). An existing deployment sets its current
# size before planning.
data_volume_size_gib = 5

# Administrator-created boundary policy, named outside the resource prefix and
# created before the operator role is used.
host_permissions_boundary_arn = "arn:aws:iam::111122223333:policy/minecraft-host-boundary"

# Hostname that players use and the ID of its Cloudflare zone. The A record must
# already exist. The Cloudflare API token never belongs in this file.
public_hostname    = "mc.example.com"
cloudflare_zone_id = "0123456789abcdef0123456789abcdef"

# Match the installed runtime before planning. The default "both" includes
# built-in signaling and WebRTC. Use "raknet" for an exact legacy RakNet runtime;
# this omits signaling/WebRTC ingress and ICE UDP egress without changing Java,
# RakNet or additional instance listeners.
# bedrock_transport = "raknet"
