# Private backend configuration: separate keys for host and bootstrap state.
bucket              = "example-replace-with-private-unique-state-name"
key                 = "infrastructure/terraform.tfstate"
region              = "us-west-2"
encrypt             = true
use_lockfile        = true
allowed_account_ids = ["123456789012"]
assume_role = {
  role_arn = "arn:aws:iam::123456789012:role/example-operator"
}
