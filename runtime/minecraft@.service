[Unit]
Description=Start the guarded Minecraft instance %i
Requires=minecraft-storage.service docker.service
After=minecraft-storage.service docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/minecraft-instance --config /etc/minecraft/operator.json start %i
TimeoutStartSec=3600
