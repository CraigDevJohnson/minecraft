#!/usr/bin/env bash
# Opt-in session setup has no credential bytes or private configuration.
install -d -m 0755 /usr/local/lib/minecraft-bootstrap
base64 --decode >/usr/local/lib/minecraft-bootstrap/install-aws-cli.sh <<'CLI_INSTALLER'
${cli_installer_base64}
CLI_INSTALLER
base64 --decode >/usr/local/sbin/minecraft-bootstrap <<'RELEASE_SCRIPT'
${release_script_base64}
RELEASE_SCRIPT
chmod 0755 /usr/local/sbin/minecraft-bootstrap
chmod 0644 /usr/local/lib/minecraft-bootstrap/install-aws-cli.sh
timeout --kill-after=10s 900s bash /usr/local/lib/minecraft-bootstrap/install-aws-cli.sh
